    const BACKGROUND = 0x000000;

    const AMBER = 0xFFAA00;
    const SKY = 0x00AAFF;
    const ORANGE = 0xFF5500;

    //! The dial through dawn and dusk, and the sun field's icon then
    const TWILIGHT = ORANGE;
}
